DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
OPENAI_API_KEY=
# Restrict every file operation to this directory.
ONEDRIVE_ROOT=/Users/YOUR_USERNAME/Library/CloudStorage/OneDrive-Personal/PROJECT_FOLDER
# Low-cost defaults; change without editing code if needed.
OPENAI_ROUTER_MODEL=gpt-5.4-mini
OPENAI_OCR_MODEL=gpt-5.4-mini
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
# OCR safety and demo limits.
OCR_MAX_PAGES_PER_RUN=20
OCR_RENDER_DPI=160
OCR_MAX_CANDIDATES=5
OCR_SEARCH_MAX_DEPTH=4
# Google OAuth desktop-app files. Never commit these.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_STUDY_SHEET=공부일정
GOOGLE_PROJECT_SHEET=프로젝트일정
# The bot always replies in English.
APP_TIMEZONE=Asia/Seoul
