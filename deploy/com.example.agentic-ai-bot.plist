<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.agentic-ai-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-W</string>
    <string>-n</string>
    <string>-g</string>
    <string>-a</string>
    <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app</string>
    <string>--stdout</string>
    <string>/Users/YOUR_USERNAME/PATH_TO_PROJECT/logs/bot.stdout.log</string>
    <string>--stderr</string>
    <string>/Users/YOUR_USERNAME/PATH_TO_PROJECT/logs/bot.stderr.log</string>
    <string>--env</string>
    <string>PYTHONPATH=/Users/YOUR_USERNAME/PATH_TO_PROJECT/.venv/lib/python3.9/site-packages</string>
    <string>--env</string>
    <string>PYTHONPYCACHEPREFIX=/private/tmp/agentic-ai-pycache</string>
    <string>--args</string>
    <string>/Users/YOUR_USERNAME/PATH_TO_PROJECT/main.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/PATH_TO_PROJECT</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PYTHONPYCACHEPREFIX</key>
    <string>/private/tmp/agentic-ai-pycache</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/PATH_TO_PROJECT/logs/bot.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/PATH_TO_PROJECT/logs/bot.stderr.log</string>
</dict>
</plist>
